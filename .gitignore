# ── Personal data (never commit) ──────────────────────────────────────────────
# Everything in jobbot/data/ is secret by default; only *.example.json templates
# are tracked. New token/credential files are safe without a gitignore edit.
jobbot/data/*
!jobbot/data/*.example.json

# ── Google credential files (if copied here) ──────────────────────────────────
client_secret*.json
*-service-account*.json
lyrical-star*.json
service_account*.json

# ── Secrets / env ─────────────────────────────────────────────────────────────
.env
*.env
.env.*

# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ── Virtual envs ──────────────────────────────────────────────────────────────
.venv/
venv/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
tests
.coverage*
pytest*
*.db-shm
*.db-wal
jobot_next_phase.md
jobbot_next_phase.md
Two bugs fixed.txt
